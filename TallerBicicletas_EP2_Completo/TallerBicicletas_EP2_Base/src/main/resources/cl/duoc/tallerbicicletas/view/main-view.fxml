<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="465.0" prefWidth="940.0" spacing="14.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.tallerbicicletas.controller.MainController">
    <padding>
        <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2933;"
           text="Registro de bicicletas" />

    <HBox spacing="22.0" VBox.vgrow="ALWAYS">
        <!-- Columna izquierda: Formulario -->
        <VBox minWidth="330.0" prefWidth="345.0" spacing="10.0">
            <GridPane hgap="12.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="125.0" prefWidth="130.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" prefWidth="195.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints vgrow="SOMETIMES" />
                    <RowConstraints vgrow="SOMETIMES" />
                    <RowConstraints vgrow="SOMETIMES" />
                    <RowConstraints vgrow="SOMETIMES" />
                </rowConstraints>

                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbTipo" maxWidth="1.7976931348623157E308" promptText="Seleccione..."
                          GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Año de fabricación:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtAnio" maxWidth="110.0" prefWidth="110.0"
                           GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Peso (kg):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtPeso" maxWidth="110.0" prefWidth="110.0"
                           GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>

            <TitledPane fx:id="paneElectrica" collapsible="false" disable="true"
                        text="Datos de la bicicleta eléctrica">
                <VBox spacing="8.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label minWidth="105.0" text="Autonomía (km):" />
                        <TextField fx:id="txtAutonomia" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <VBox spacing="6.0">
                        <padding>
                            <Insets left="117.0" />
                        </padding>
                        <CheckBox fx:id="chkBateriaCertificada" text="Batería certificada" />
                        <CheckBox fx:id="chkGarantiaExtendida" text="Garantía extendida" />
                    </VBox>
                </VBox>
            </TitledPane>

            <TitledPane fx:id="paneMontanya" collapsible="false" disable="true"
                        text="Datos de la bicicleta de montaña">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <Label minWidth="105.0" text="Suspensiones:" />
                    <TextField fx:id="txtSuspensiones" HBox.hgrow="ALWAYS" />
                </HBox>
            </TitledPane>

            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#handleRegistrar"
                        prefWidth="95.0" text="Registrar" />
            </HBox>
        </VBox>

        <!-- Columna derecha: Tabla y botón Eliminar -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <TableView fx:id="tblBicicletas" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
                    <TableColumn fx:id="colCodigo" prefWidth="85.0" style="-fx-alignment: CENTER;" text="Código" />
                    <TableColumn fx:id="colAnio" prefWidth="65.0" style="-fx-alignment: CENTER;" text="Año" />
                    <TableColumn fx:id="colPeso" prefWidth="85.0" style="-fx-alignment: CENTER-RIGHT;" text="Peso (kg)" />
                    <TableColumn fx:id="colCosto" prefWidth="125.0" style="-fx-alignment: CENTER-RIGHT;" text="Costo mantención" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT">
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#handleEliminar"
                        prefWidth="85.0" text="Eliminar" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Área de mensajes -->
    <Label fx:id="lblMensaje" minHeight="22.0"
           style="-fx-font-weight: bold; -fx-font-size: 13px;" text="" wrapText="true" />
</VBox>
