<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="470.0" prefWidth="880.0" spacing="14.0"
      style="-fx-background-color: #f4f5f7;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.viviendas.controller.MainController">
    <padding>
        <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2933;"
               text="Registro de viviendas" />

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- Formulario de registro -->
                <VBox prefWidth="330.0" spacing="12.0">
                    <children>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="115.0" prefWidth="115.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" prefWidth="200.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints vgrow="SOMETIMES" />
                                <RowConstraints vgrow="SOMETIMES" />
                                <RowConstraints vgrow="SOMETIMES" />
                                <RowConstraints vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <ComboBox fx:id="cmbTipo" prefWidth="200.0" promptText="Seleccione..."
                                          GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Superficie (m²):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField fx:id="txtSuperficie" maxWidth="110.0" prefWidth="110.0"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Habitaciones:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <TextField fx:id="txtHabitaciones" maxWidth="110.0" prefWidth="110.0"
                                           GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            </children>
                        </GridPane>

                        <!-- Datos del departamento -->
                        <VBox fx:id="panelDepartamento" disable="true" spacing="8.0"
                              style="-fx-border-color: #cbd2d9; -fx-border-radius: 5; -fx-padding: 10;">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #52606d;"
                                       text="Datos del departamento" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label minWidth="75.0" text="Piso:" />
                                        <TextField fx:id="txtPiso" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <VBox spacing="6.0">
                                    <padding>
                                        <Insets left="85.0" />
                                    </padding>
                                    <children>
                                        <CheckBox fx:id="chkGastoComunAlDia" text="Gasto común al día" />
                                        <CheckBox fx:id="chkEstacionamiento" text="Estacionamiento asignado" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Datos de la casa -->
                        <VBox fx:id="panelCasa" disable="true" spacing="8.0"
                              style="-fx-border-color: #cbd2d9; -fx-border-radius: 5; -fx-padding: 10;">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #52606d;"
                                       text="Datos de la casa" />
                                <HBox>
                                    <padding>
                                        <Insets left="85.0" />
                                    </padding>
                                    <children>
                                        <CheckBox fx:id="chkTienePatio" text="Cuenta con patio" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button fx:id="btnRegistrar" mnemonicParsing="false"
                                        onAction="#onRegistrar" prefWidth="100.0" text="Registrar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Tabla y botón eliminar -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tblViviendas" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTipo" prefWidth="105.0" text="Tipo" />
                                <TableColumn fx:id="colCodigo" prefWidth="95.0" text="Código" />
                                <TableColumn fx:id="colSuperficie" prefWidth="110.0" text="Superficie (m²)" />
                                <TableColumn fx:id="colHabitaciones" prefWidth="95.0" text="Habitaciones" />
                                <TableColumn fx:id="colCostoArriendo" prefWidth="115.0" text="Costo arriendo" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="btnEliminar" mnemonicParsing="false"
                                        onAction="#onEliminar" prefWidth="95.0" text="Eliminar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Área de mensajes -->
        <Label fx:id="lblMensaje" minHeight="20.0"
               style="-fx-font-weight: bold; -fx-font-size: 13px;"
               text="" wrapText="true" />
    </children>
</VBox>
